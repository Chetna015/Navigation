{
  "name": "csjmu-ai-summit-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "start:backend": "cd backend && node server.js",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
